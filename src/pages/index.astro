---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Keystatic + GenCSS – test">
    <section>
        <div class="container">
            <div class="stack">
                <p class="heading-label">Testprosjekt</p>
                <h1 class="heading-hook">
                    Keystatic CMS og <span class="accent">GenCSS</span>
                </h1>
                <p style="color: var(--text-muted); max-width: 60ch;">
                    Ein enkel test av Keystatic som CMS og GenCSS som alternativ til Tailwind.
                    Blogginnlegg vert redigert via Keystatic Studio.
                </p>
                <div class="cluster">
                    <a href="/blogg" class="btn btn--primary">Sjå blogg</a>
                    <a href="/keystatic" class="btn btn--primary-outline">Opne Studio</a>
                </div>
            </div>
        </div>
    </section>
</Layout>